{
  "name": "with-vue",
  "displayName": "With vue",
  "version": "0.0.1",
  "description": "A basic Plasmo extension.",
  "author": "Plasmo Corp. <foss@plasmo.com>",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build && npm run copy-main-script",
    "package": "plasmo package",
    "copy-main-script": "node -e \"require('fs').copyFileSync('scripts/doubao-download-main.js','build/chrome-mv3-prod/doubao-download-main.js')\""
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "vue": "3.3.4"
  },
  "devDependencies": {
    "@types/chrome": "0.0.241",
    "@types/node": "20.4.2",
    "typescript": "5.1.6"
  },
  "manifest": {
    "permissions": [
      "storage"
    ],
    "host_permissions": [
      "https://*/*"
    ],
    "web_accessible_resources": [
      {
        "resources": ["doubao-download-main.js"],
        "matches": ["https://*.doubao.com/*", "https://doubao.com/*"]
      }
    ]
  }
}
